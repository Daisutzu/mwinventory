rules_version = '2';

// App interna senza login: chiunque abbia l'app puo' leggere e scrivere
// il catalogo prodotti, cosi' le modifiche fatte dalla schermata di
// gestione si sincronizzano tra i dispositivi dello staff. Il catalogo
// non contiene dati sensibili (e' comunque gia' visibile a chiunque apra
// l'app stessa).
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      allow read, write: if true;
    }
  }
}
