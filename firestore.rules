rules_version = '2';

// L'app chiede una password condivisa allo staff prima di mostrare
// qualunque cosa (vedi lib/auth_gate_screen.dart): qui si fa valere la
// stessa regola anche lato database, cosi' non basta scavalcare l'app per
// leggere o modificare il catalogo.
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      allow read, write: if request.auth != null;
    }
    // Conteggio aggregato di quante volte ogni prodotto e' stato aperto,
    // su tutti i dispositivi (vedi search_history_repository.dart). E' una
    // collection separata da "products" apposta: cosi' un salvataggio del
    // catalogo da un dispositivo non puo' mai sovrascrivere i conteggi
    // accumulati dagli altri.
    match /productViewCounts/{productId} {
      allow read, write: if request.auth != null;
    }
  }
}
